# Maktaba — root .env.example
# Used by `docker-compose up` (docker-compose.yml reads a .env file in this
# same directory automatically). Copy to .env and fill in real values —
# never commit the real .env.

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost

# Safaricom Daraja — leave blank to run with the mocked payment flow
# (see backend/services/darajaService.js and docs/DarajaIntegration.md).
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

GOOGLE_BOOKS_API_KEY=
