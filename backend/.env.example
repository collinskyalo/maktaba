# Maktaba backend — example environment variables
# Copy to .env and fill in real values. NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# Comma-separated allowed origins for CORS in production, e.g.:
#   FRONTEND_URL=https://maktaba.co.ke,https://www.maktaba.co.ke
# Leave unset in development to allow any origin.
FRONTEND_URL=

# Database
DATABASE_URL=postgres://user:password@localhost:5432/maktaba
SQLITE_PATH=./database/maktaba.sqlite

# Used only by `npm test` (see tests/globalSetup.js) — a separate database
# that gets wiped and reseeded on every test run. Never point this at your
# real development or production database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/maktaba_test

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Safaricom Daraja API (fill in Phase 10 — never hardcode in source)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/callback

# Book data providers
GOOGLE_BOOKS_API_KEY=

# Google Sign-In (Phase 7 placeholder — not implemented yet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
